<?xml version="1.0" encoding="UTF-8"?>
<!--
  Asignación del rol de web.xml al desplegar el EAR: DQUser = cualquier usuario autenticado (los que entran a ICN).
  Los grupos que pueden escribir no son un rol de WebSphere: están en la tabla tbl_icn_designer_groups.
-->
<application-bnd xmlns="http://websphere.ibm.com/xml/ns/javaee"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://websphere.ibm.com/xml/ns/javaee http://websphere.ibm.com/xml/ns/javaee/ibm-application-bnd_1_2.xsd"
                 version="1.2">
    <security-role name="DQUser">
        <special-subject type="ALL_AUTHENTICATED_USERS"/>
    </security-role>
</application-bnd>
